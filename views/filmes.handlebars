<div class="section-container" style="padding-top: 30px;">
  <h1 style="text-align: center; margin-bottom: 25px;">Catálogo de Filmes</h1>

  <div class="filtros-genero">
    <a href="/filmes" class="btn-filtro {{#unless generoSelecionado}}ativo{{/unless}}">Todos</a>
    
    {{#each generos}}
      <a href="/filmes?genero={{id}}" class="btn-filtro">
        {{name}}
      </a>
    {{/each}}
  </div>

  {{#if filmes.length}}
    <div class="container-filmes">
      {{#each filmes}}
        <div class="card-filme">
          {{#if poster_path}}
            <img src="https://image.tmdb.org/t/p/w500{{poster_path}}" alt="{{title}}">
          {{else}}
            <div style="height: 300px; background: #333; display: flex; align-items: center; justify-content: center;">Sem Imagem</div>
          {{/if}}

          <div class="card-info">
            <h3>{{title}}</h3>
            <p class="nota">⭐ {{vote_average}}</p>
            <a href="/filme/{{id}}" class="button btn-card">Detalhes</a>
          </div>
        </div>
      {{/each}}
    </div>
  {{else}}
    <div style="text-align: center; padding: 50px;">
      <h3>Nenhum filme encontrado para este gênero.</h3>
    </div>
  {{/if}}
</div>